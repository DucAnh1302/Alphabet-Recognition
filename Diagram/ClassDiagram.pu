@startuml Class Diagram
skinparam classAttributeIconSize 0

class DataLoader {
  + preprocess_image(image_path: String, is_input: Boolean): ndarray
  + load_training_data(root_folder: String, max_per_class: int): tuple
  + load_input_folder(input_folder: String): tuple
}

class AlphabetRecognizer {
  - hog: cv2.HOGDescriptor
  - model: LogisticRegression
  + is_trained: Boolean
  - _extract_hog_features(X: ndarray): ndarray
  + transform_features(X: ndarray): ndarray
  + train(X: ndarray, y: ndarray): float
  + predict(X_input: ndarray): ndarray
  + predict_proba(X_input: ndarray): ndarray
  + save(filepath: String): void
  + load(filepath: String): Boolean
}

class DrawingApp {
  - root: tk.Tk
  - loader: DataLoader
  - recognizer: AlphabetRecognizer
  - canvas: tk.Canvas
  - fig: matplotlib.figure.Figure
  - axes: ndarray
  + setup_ui(): void
  + start_drawing(event): void
  + draw_lines(event): void
  + clear_canvas(): void
  + clear_dashboard(): void
  + predict(): void
  + shutdown_resources(): void
}

DrawingApp "1" *-- "1" DataLoader : uses
DrawingApp "1" *-- "1" AlphabetRecognizer : uses
@enduml