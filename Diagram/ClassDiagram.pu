@startuml ClassDiagram
skinparam classAttributeIconSize 0
skinparam roundcorner 10
skinparam defaultFontName Arial

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #343A40
    ArrowColor #007BFF
    
    HeaderBackgroundColor<<Config>> #FFF9C4
    HeaderBackgroundColor<<Core>> #E3F2FD
    HeaderBackgroundColor<<AI>> #E8F5E9
}

class Config << (M, #FFB300) Config >> {
    + IMG_SIZE: tuple(28, 28)
    + BASE_DIR: str
    + DATA_PATH: str
    + INPUT_PATH: str
    + OUTPUT_PATH: str
    + MODEL_PATH: str
}

class DataLoader << (C, #1E88E5) Core >> {
    + preprocess_image(image_path: str, is_input: bool): numpy.ndarray
    + load_training_data(root_folder: str): tuple
    + load_input_folder(input_folder: str): tuple
}

class AlphabetRecognizer << (C, #43A047) AI >> {
    - model: LogisticRegression
    - is_trained: bool
    + train(X: numpy.ndarray, y: numpy.ndarray): float
    + predict(X_input: numpy.ndarray): numpy.ndarray
    + save(filepath: str): void
    + load(filepath: str): bool
}

class Main << (M, #E53935) Core >> {
    + main(): void
}

Main --> DataLoader : Khởi tạo & Sử dụng >
Main --> AlphabetRecognizer : Khởi tạo & Sử dụng >
DataLoader ..> Config : <import>
Main ..> Config : <import>
@enduml