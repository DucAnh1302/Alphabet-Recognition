@startuml Hệ thống chính Diagram
left to right direction
skinparam packageStyle rectangle
actor "Người dùng" as User

rectangle "Hệ thống Nhận diện Chữ cái (HOG + Logistic)" {
  usecase "Vẽ chữ cái lên bảng điện tử" as UC1
  usecase "Phân tích và Dự đoán chữ cái" as UC2
  usecase "Xem bảng điều khiển XAI (6 bước)" as UC3
  usecase "Xóa bảng vẽ" as UC4
  usecase "Huấn luyện mô hình (Training)" as UC5
  usecase "Dự đoán hàng loạt (Batch Inference)" as UC6
  usecase "Xem log kết quả (result.txt)" as UC7
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7

UC2 .> UC3 : <<include>>
@enduml

