@startuml Activity Diagram with Main.py
start
:Chạy file main.py;
:Khởi tạo DrawingApp (GUI);
:Tải DataLoader và AlphabetRecognizer;
if (Kiểm tra saved_model.pkl tồn tại?) then (Có)
  :Tải trọng số mô hình;
  :Cờ is_trained = True;
else (Không)
  :Hiển thị cảnh báo "Chưa có model";
endif
:Hiển thị giao diện Whiteboard & XAI Dashboard;
repeat
  :Người dùng vẽ chữ lên Canvas;
  if (Người dùng nhấn nút?) then (Xóa bảng)
    :Xóa Canvas;
    :Xóa biểu đồ Matplotlib;
  else (Phân tích AI)
    :Lưu ảnh tạm (temp_draw.jpg);
    :DataLoader.preprocess_image();
    :AlphabetRecognizer.transform_features() (HOG);
    :AlphabetRecognizer.predict_proba() (Softmax);
    :Tính toán Z-score tuyến tính;
    :Trích xuất ma trận trọng số (Weights);
    :Cập nhật kết quả & 6 biểu đồ lên Dashboard;
  endif
repeat while (Đóng ứng dụng?) is (Không)
-> Có;
:Giải phóng tài nguyên (shutdown_resources);
stop
@enduml

@startuml Activity Diagram with MainTestMainForProject.py
start
:Chạy file MainTestMainForProject.py;
:Khởi tạo DataLoader và AlphabetRecognizer;
if (Model đã tồn tại?) then (Không)
  :DataLoader.load_training_data(Data/);
  :Đọc và tiền xử lý ảnh A-Z;
  :Chia tập Train/Test (80/20);
  :AlphabetRecognizer.train();
  :Tính vector HOG & Fit LogisticRegression;
  :Lưu mô hình (saved_model.pkl);
  :Ghi nhận Accuracy;
else (Có)
  :Tải mô hình cũ;
endif
:DataLoader.load_input_folder(Input/);
if (Có ảnh đầu vào?) then (Có)
  :AlphabetRecognizer.predict();
  :Xuất mảng nhãn dự đoán;
  :Mở file Output/result.txt;
  :Ghi thời gian thực (Datetime);
  :Ghi tên file và nhãn dự đoán tương ứng;
else (Không)
  :Báo lỗi thư mục Input trống;
endif
stop
@enduml